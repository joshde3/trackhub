# Copy to .env for local runs and fill in values. .env is git-ignored; never commit real values.
# In production these are set as Railway service variables.

# Which halves of the app to start (ADR 0001): api, worker, or both
TRACKHUB_PROFILES=api,worker
PORT=8080

# Postgres (Railway sets these automatically for its Postgres service)
PGHOST=localhost
PGPORT=5432
PGDATABASE=trackhub
PGUSER=trackhub
PGPASSWORD=

# Required: the app refuses to start without these.
# Google OAuth *web* client id from Google Cloud Console (APIs & Services > Credentials). Not secret,
# but kept out of the repo so forks use their own.
GOOGLE_CLIENT_ID=
# 17TRACK API key from https://admin.17track.net (Settings > Security). SECRET.
TRACK17_API_KEY=


# Optional. Logs are JSON by default (for Railway); leave empty for readable lines locally.
LOG_FORMAT=
# Optional: push metrics to Grafana Cloud (Home > Connections > OpenTelemetry). SECRET header.
OTLP_METRICS_ENABLED=false
# OTLP_METRICS_URL=https://otlp-gateway-<region>.grafana.net/otlp/v1/metrics
# OTLP_AUTH_HEADER=Basic <base64 of instanceId:token>
